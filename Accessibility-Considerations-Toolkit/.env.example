# Copy this file to .env and fill in real values.
# PowerShell: Copy-Item .env.example .env

# All models now route through the GitHub Copilot SDK provider.
# No API keys needed — authenticate with: copilot login

# Optional model overrides for tests/evals.
# Defaults are defined in tests/evals/config.yaml.
EVAL_MODEL_PRIMARY=
EVAL_MODEL_SECONDARY=
EVAL_MODEL_CLAUDE=
EVAL_JUDGE_MODEL=

# Optional rubric / run behavior overrides.
EVAL_RUBRIC_THRESHOLD=
# Set to 1 for quick mode
EVAL_QUICK=

# Consideration input: md (authoring Markdown) or schema (generated YAML).
CONSIDERATION_SOURCE=md
