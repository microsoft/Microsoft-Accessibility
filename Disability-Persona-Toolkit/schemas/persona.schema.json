{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "persona.schema.json",
  "title": "Accessibility Persona (compact)",
  "description": "Schema for EN 301 549 FPS accessibility persona files. Machine-oriented, LLM-agnostic format. For stub personas, use persona-stub.schema.json.",
  "type": "object",
  "required": ["clause", "title", "alias", "status", "fps_statement", "prompt", "assistive_tech", "strategies", "user_variants", "learning", "heuristic_overrides"],
  "additionalProperties": false,
  "properties": {
    "clause": {
      "type": "string",
      "pattern": "^4\\.2\\.\\d+[a-z]?$",
      "description": "EN 301 549 FPS clause number."
    },
    "title": {
      "type": "string",
      "description": "Official EN 301 549 FPS clause title."
    },
    "fps_statement": {
      "type": "string",
      "description": "The full EN 301 549 Functional Performance Statement text for this clause."
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Short kebab-case identifier."
    },
    "status": {
      "const": "elaborated"
    },
    "device_context": {
      "type": "string",
      "enum": ["desktop", "mobile", "all"],
      "description": "Default device context for all items in this persona."
    },
    "baseline_excludes": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Baseline item IDs to omit from this persona."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "prompt": {
      "$ref": "#/$defs/prompt"
    },
    "assistive_tech": {
      "type": "array",
      "items": { "$ref": "#/$defs/assistive_tech" },
      "minItems": 1
    },
    "strategies": {
      "type": "array",
      "items": { "$ref": "#/$defs/strategy" },
      "minItems": 1,
      "description": "Persona-specific strategies. Baseline merged at render time."
    },
    "user_variants": {
      "type": "array",
      "items": { "$ref": "#/$defs/user_variant" },
      "minItems": 1,
      "description": "Persona-specific variants. Baseline merged at render time."
    },
    "learning": {
      "type": "array",
      "items": { "$ref": "#/$defs/learning_item" },
      "minItems": 1,
      "description": "Persona-specific learning guidance. Baseline merged at render time."
    },
    "heuristic_overrides": {
      "type": "object",
      "description": "Map of heuristic number (1-10) to persona-specific lens override text.",
      "propertyNames": { "pattern": "^([1-9]|10)$" },
      "additionalProperties": { "type": "string" },
      "minProperties": 10,
      "maxProperties": 10
    }
  },

  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "source_urls",
        "upstream_license",
        "repository_license",
        "required_notice",
        "adaptation",
        "reviewed_on"
      ],
      "additionalProperties": false,
      "properties": {
        "source_urls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "minItems": 1,
          "uniqueItems": true
        },
        "upstream_license": { "type": "string" },
        "repository_license": { "type": "string" },
        "required_notice": { "type": "string" },
        "adaptation": { "const": true },
        "reviewed_on": {
          "type": "string",
          "format": "date"
        }
      }
    },

    "prompt": {
      "type": "object",
      "required": ["role", "blocked_input", "user_types", "checklist"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "description": "One-sentence role/constraint definition." },
        "blocked_input": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Input methods this user cannot use."
        },
        "user_types": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Sub-populations as 'Label — traits' strings."
        },
        "checklist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Evaluation criteria as 'Label: criteria' strings."
        }
      }
    },

    "assistive_tech": {
      "type": "object",
      "required": ["id", "category", "platforms", "model"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Kebab-case identifier." },
        "category": { "type": "string" },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "model": { "type": "string", "description": "Interaction model summary." }
      }
    },

    "strategy": {
      "type": "object",
      "required": ["id", "mechanisms", "reqs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Kebab-case identifier; used for baseline filtering." },
        "mechanisms": { "type": "array", "items": { "type": "string" } },
        "behavior": { "type": "string", "description": "What the user does." },
        "reqs": { "type": "string", "description": "What the UI must provide." }
      }
    },

    "user_variant": {
      "type": "object",
      "required": ["id", "uses_at", "expects"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Kebab-case identifier." },
        "behavior": { "type": "string", "description": "User profile summary." },
        "uses_at": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Assistive technology ids used by this variant. Empty when the source specifies no assistive technology."
        },
        "uses_strategies": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Persona-specific strategy ids this variant relies on. Baseline strategies are inherited separately."
        },
        "expects": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "learning_item": {
      "type": "object",
      "required": ["id", "facts"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Kebab-case identifier." },
        "facts": { "type": "string", "description": "Learning guidance for this scenario." }
      }
    }
  }
}
